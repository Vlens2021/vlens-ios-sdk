<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>VLens Demo</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- ── Usage descriptions (required by App Store Review) ─────────────── -->
	<key>NFCReaderUsageDescription</key>
	<string>VLens reads the NFC chip in your e-Passport to securely verify your identity.</string>
	<key>NSCameraUsageDescription</key>
	<string>VLens uses the camera to scan your passport and ID card for identity verification.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>VLens requires microphone access as part of the identity verification process.</string>

	<!-- ── NFC — ISO 7816 ePassport AID ─────────────────────────────────── -->
	<!-- Without this key iOS blocks SELECT of the ePassport applet (AID A0000002471001) -->
	<key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
	<array>
		<string>A0000002471001</string>
	</array>

	<!-- ── App Transport Security ─────────────────────────────────────────── -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- ── UI ────────────────────────────────────────────────────────────── -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
